# Ignore all
/*
cmake/*


## Unignore the following extensions
!*.h
!*.cc
!*.cpp
!*.sh
!*.MD
!*.py

# Unignore the following files
!*CMakeLists.txt
!.travis.yml
!.gitignore

# Unignore source code directories
!benchmark/
!cmake
!common/
!core/
!database/
!protocol/
!scripts/

# Submodules
!.gitmodules
!external/

# Data, run outputs and plots are never tracked, wherever they are written
# (build-*/, det-runs/, speed-runs/ are already covered by /* above)...
*.csv
*.log
*.out
*.png
*.svg
*.pdf

# ...except figures deliberately committed under docs/
!docs/
!docs/*.png
!docs/*.svg
